# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=schedule_management
SECRET_KEY=your_secret_key

# SMTP (admin notification emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=notifications@example.com
SMTP_USE_TLS=true

# Optional: recipient for `python test_smtp_email.py` (defaults to first admin email)
# SMTP_TEST_TO=admin@example.com
